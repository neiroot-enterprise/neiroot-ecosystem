# Локальный запуск: scripts/start-local.ps1 автоматически создаёт .env.
# Можно скопировать этот файл в .env: пустые значения генерируются на чистой среде.
# Не переносить чужие секреты и не менять их при существующем volume.
# Все значения: 64 шестнадцатеричных символа (32 случайных байта).
# Администратор PostgreSQL; используется для начального создания баз и ролей.
POSTGRES_PASSWORD=
# Роль auth_app: служебная база Keycloak auth.
AUTH_PASSWORD=
# Владелец core: выполнение миграций.
CORE_OWNER_PASSWORD=
# Прикладная роль core с tenant-изоляцией/RLS.
CORE_APP_PASSWORD=
# Владелец bff: миграции базы сессий.
BFF_OWNER_PASSWORD=
# Прикладная роль bff: хранение веб-сессий.
BFF_APP_PASSWORD=
# Пароль локального администратора Keycloak neiroot-local-admin.
KEYCLOAK_ADMIN_PASSWORD=
# Секрет OIDC-клиента neiroot-web для серверного входа BFF.
KEYCLOAK_WEB_SECRET=
# Секрет сервисного клиента ядра для создания учётных записей.
KEYCLOAK_PROVISIONER_SECRET=
# Ключ шифрования токенов в сессиях BFF; сохранять вместе с базой.
SESSION_ENCRYPTION_KEY=
