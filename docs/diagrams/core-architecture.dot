Files [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="330" HEIGHT="212" FIXEDSIZE="TRUE" COLOR="#28568c" BGCOLOR="#1b2a3e"><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="CENTER">«component»<BR/><B>Файловое хранилище</B></TD></TR><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="54" ALIGN="LEFT" BORDER="1" SIDES="TB">S3 API<BR ALIGN="LEFT"/></TD></TR><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="LEFT">Документы и файлы<BR ALIGN="LEFT"/>Изоляция по tenant_id<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
