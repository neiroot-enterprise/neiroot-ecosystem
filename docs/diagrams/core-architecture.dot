Money [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="330" HEIGHT="236" FIXEDSIZE="TRUE" COLOR="#28568c" BGCOLOR="#1b2a3e"><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="CENTER">«module»<BR/><B>Деньги</B></TD></TR><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="LEFT" BORDER="1" SIDES="TB">Go<BR ALIGN="LEFT"/>PostgreSQL core / money<BR ALIGN="LEFT"/></TD></TR><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="LEFT">Учёт денежных операций<BR ALIGN="LEFT"/>Кассы, банки и зарплата<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
