subgraph cluster_pattern {
label="«package» Шаблон каждого модуля
Clean Architecture · порты и адаптеры"; labeljust=l;
color="#60758d"; bgcolor="#142033"; margin=25;
Incoming [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="330" HEIGHT="236" FIXEDSIZE="TRUE" COLOR="#28568c" BGCOLOR="#1b2a3e"><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="CENTER">«adapter»<BR/><B>Входные адаптеры</B></TD></TR><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="LEFT" BORDER="1" SIDES="TB">Go / chi<BR ALIGN="LEFT"/>HTTP или внутренний API<BR ALIGN="LEFT"/></TD></TR><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="LEFT">Принимают запросы<BR ALIGN="LEFT"/>Вызывают входные порты<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Application [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="330" HEIGHT="212" FIXEDSIZE="TRUE" COLOR="#28568c" BGCOLOR="#1b2a3e"><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="CENTER">«application»<BR/><B>Сценарии и порты</B></TD></TR><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="54" ALIGN="LEFT" BORDER="1" SIDES="TB">Go / интерфейсы<BR ALIGN="LEFT"/></TD></TR><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="LEFT">Выполнение операций<BR ALIGN="LEFT"/>Входные и выходные порты<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Outgoing [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="330" HEIGHT="236" FIXEDSIZE="TRUE" COLOR="#28568c" BGCOLOR="#1b2a3e"><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="CENTER">«adapter»<BR/><B>Выходные адаптеры</B></TD></TR><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="LEFT" BORDER="1" SIDES="TB">Go<BR ALIGN="LEFT"/>PostgreSQL / S3 / NATS<BR ALIGN="LEFT"/></TD></TR><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="LEFT">Реализуют выходные порты<BR ALIGN="LEFT"/>Работают с инфраструктурой<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Domain [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="330" HEIGHT="212" FIXEDSIZE="TRUE" COLOR="#28568c" BGCOLOR="#1b2a3e"><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="CENTER">«domain»<BR/><B>Домен модуля</B></TD></TR><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="54" ALIGN="LEFT" BORDER="1" SIDES="TB">Go / без инфраструктуры<BR ALIGN="LEFT"/></TD></TR><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="LEFT">Сущности и правила бизнеса<BR ALIGN="LEFT"/>Проверка инвариантов<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
{rank=same; Incoming; Application; Outgoing;}
