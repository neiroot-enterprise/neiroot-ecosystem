digraph Core {
graph [rankdir=TB, bgcolor="#171717", pad=0.4, nodesep=1.1, ranksep=0.9, splines=ortho, outputorder=edgesfirst, fontname="Arial", fontsize=18, fontcolor="#f2f4f6", compound=true];
node [shape=plain, fontname="Arial", fontsize=16, fontcolor="#f2f4f6"];
edge [color="#bac3d0", fontname="Arial", fontsize=12, fontcolor="#bac3d0", arrowsize=0.65];
Gateway [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="330" HEIGHT="260" FIXEDSIZE="TRUE" COLOR="#28568c" BGCOLOR="#1b2a3e"><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="CENTER">«component»<BR/><B>API Gateway / Web BFF</B></TD></TR><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="102" ALIGN="LEFT" BORDER="1" SIDES="TB">Go / chi<BR ALIGN="LEFT"/>Traefik<BR ALIGN="LEFT"/>REST / SSE<BR ALIGN="LEFT"/></TD></TR><TR><TD WIDTH="328" FIXEDSIZE="TRUE" CELLPADDING="12" HEIGHT="78" ALIGN="LEFT">Вход из веб-интерфейса<BR ALIGN="LEFT"/>Запросы к ядру<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
