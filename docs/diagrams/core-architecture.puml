@startuml core_architecture
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide circle
top to bottom direction
title Ядро приложения — архитектура v0.3
class "API Gateway / Web BFF" as Gateway <<component>> {
  Go / chi
  Traefik
  REST / SSE
  --
  Вход из веб-интерфейса
  Запросы к ядру
}
class "База ядра" as Database <<database>> {
  PostgreSQL core
  money / company / sales / settings
  --
  Схемы принадлежат модулям
  Изоляция по tenant_id
}
class "Брокер событий" as Events <<component>> {
  NATS JetStream
  --
  События через Outbox
  Интеграция микросервисов
}
class "Файловое хранилище" as Files <<component>> {
  S3 API
  --
  Документы и файлы
  Изоляция по tenant_id
}
package "Ядро приложения / модульный монолит / Go" <<microservice>> {
class "Моя экосистема" as Company <<module>> {
  Go
  PostgreSQL core / company
  --
  Структура бизнесов и юрлиц
  Сотрудники и справочники
}
class "Деньги" as Money <<module>> {
  Go
  PostgreSQL core / money
  --
  Учёт денежных операций
  Кассы, банки и зарплата
}
class "Продажи" as Sales <<module>> {
  Go
  PostgreSQL core / sales
  --
  Документы продаж
  Номенклатура
}
class "Настройки" as Settings <<module>> {
  Go
  PostgreSQL core / settings
  --
  Настраиваемые поля
  Бизнес-права доступа
  Личный порядок меню
}
class "Разделы: Моя экосистема" as CompanySections <<sections>> {
  Структура экосистемы
  Предприятия и отделы
  Сотрудники
  Организации (юрлица)
  Договоры
  Контрагенты
  Партнеры
}
class "Разделы: Деньги" as MoneySections <<sections>> {
  Касса
  Банки
  Кредиты и займы
  Зарплата
}
class "Разделы: Продажи" as SalesSections <<sections>> {
  Счета на оплату
  Акты выполненных работ
  Номенклатура
}
class "Разделы: Настройки" as SettingsSections <<sections>> {
  Поля
  Права доступа
}
class "HTTP API ядра" as HTTP <<adapter>> {
  Go / chi / net/http
  --
  Проверка токена и tenant
  Вызов сценариев модулей
}
class "Входные адаптеры" as Incoming <<adapter>> {
  Go / chi
  HTTP или внутренний API
  --
  Принимают запросы
  Вызывают входные порты
}
class "Сценарии и порты" as Application <<application>> {
  Go / интерфейсы
  --
  Выполнение операций
  Входные и выходные порты
}
class "Выходные адаптеры" as Outgoing <<adapter>> {
  Go
  PostgreSQL / S3 / NATS
  --
  Реализуют выходные порты
  Работают с инфраструктурой
}
class "Домен модуля" as Domain <<domain>> {
  Go / без инфраструктуры
  --
  Сущности и правила бизнеса
  Проверка инвариантов
}
}
Incoming ..> Application : Вызов порта
Outgoing ..> Application : Реализация
Application ..> Domain : Зависимость кода
Gateway --> HTTP : 
HTTP --> Company : Внутренний API
HTTP --> Money : Внутренний API
HTTP --> Sales : Внутренний API
HTTP --> Settings : Внутренний API
Company *-- CompanySections : Состав разделов
Money *-- MoneySections : Состав разделов
Sales *-- SalesSections : Состав разделов
Settings *-- SettingsSections : Состав разделов
Outgoing --> Database : Чтение / запись
Outgoing --> Events : Outbox / события
Outgoing --> Files : Файлы по потребности
note "Шаблон Clean Architecture и портов/адаптеров применяется отдельно внутри каждого модуля.
Разделы — части модулей, не отдельные сервисы.
Tenant = клиент платформы; предприятие = бизнес; организация = юрлицо." as ArchitectureNote
@enduml
