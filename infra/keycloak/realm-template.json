{
  "realm": "neiroot",
  "enabled": true,
  "displayName": "NEIROOT",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru",
    "en"
  ],
  "defaultLocale": "ru",
  "loginTheme": "neiroot",
  "bruteForceProtected": true,
  "passwordPolicy": "length(8) and maxLength(256)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 28800,
  "clients": [
    {
      "clientId": "core-api",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "neiroot-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__WEB_SECRET__",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://localhost:8443/api/auth/callback"
      ],
      "webOrigins": [
        "https://localhost:8443"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:8443/login"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "core-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "core-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "full-name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "full_name",
            "claim.name": "full_name",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "middle-name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "middle_name",
            "claim.name": "middle_name",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "neiroot-provisioner",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__PROVISIONER_SECRET__",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-neiroot-provisioner",
      "enabled": true,
      "serviceAccountClientId": "neiroot-provisioner",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    }
  ]
}
